# Copy to .env (git-ignored) and replace every placeholder. Never commit real values.

# SQL Server SA password: >= 8 chars, upper + lower + digit + symbol
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Passw0rd

# HMAC key for JWT signing: at least 32 characters. Generate e.g. with:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]])
JWT_SIGNING_KEY=replace-with-a-random-string-of-at-least-32-chars

# Optional: seeds one Admin user on startup if both are set (needed for /complete, dashboard, admin endpoints)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe_Admin1!

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe_Grafana1!

# Host port for the API container (default 8080). Change it if Windows reserves it
# (check: netsh interface ipv4 show excludedportrange protocol=tcp)
API_HOST_PORT=8080
